# =============================================================================
# Production environment template
# =============================================================================
#
# Copy to .env ON THE SERVER and fill in. Never commit the filled-in copy —
# .env and .env.production are both gitignored, this .example is the only one
# that belongs in the repository.
#
# Every value marked CHANGE ME will break the install, leak data, or silently
# do nothing if left as it is. `php artisan emp:preflight` checks most of them
# and is the last step of the deploy.
# =============================================================================

APP_NAME="KEMP"
APP_ENV=production

# CHANGE ME — generate on the server, once, with: php artisan key:generate
# Sessions and every encrypted column are tied to this. Changing it later logs
# everyone out and makes previously encrypted values unreadable, so generate it
# once and then keep it in the backup of the server, not just on the server.
APP_KEY=

# Off, always. Debug pages print environment variables — database password,
# mail password, app key — to anyone who triggers an error.
APP_DEBUG=false

# The public https URL, no trailing slash. The subdomain is settled:
# hrams.devonlinetestserver.com.
# This is not cosmetic: it decides the scheme of every generated link, and the
# app forces https:// links when this says https. It is also the URL the mobile
# app and the app-store privacy-policy listing point at.
APP_URL=https://hrams.devonlinetestserver.com

# The company's operating timezone. Attendance is judged against shift times, so
# a wrong value here marks the whole workforce late.
APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Daily rather than a single file: one unrotated laravel.log grows until the
# disk fills, and a full disk stops attendance being recorded at all.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# CHANGE ME — all four come from the hosting panel, which creates the database
# and the user; this account cannot CREATE DATABASE for itself.
#
# DB_HOST is the one that catches people. On managed webspace MySQL usually
# sits on a machine of its own, so the panel hands back a hostname rather than
# 127.0.0.1, and assuming the loopback address produces a connection refused
# that reads exactly like a broken install. Copy what the panel shows.
#
# On a VPS, where you create the user yourself, grant it CREATE and DROP too:
# `db:backup --verify` restores each dump into a scratch database to prove it
# reads back. A webspace account cannot create one, so the check degrades to a
# warning there and the dumps go unproven — see BACKUP_PATH below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emp
DB_USERNAME=emp
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Cookies over TLS only. Without this the session cookie is sent on any plain
# http request to the domain, which is the whole session handed to anyone on the
# network path.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/

# The bare domain, no scheme, no port. Must match APP_URL's host exactly —
# a mismatch drops the session cookie and the login form silently loops.
SESSION_DOMAIN=hrams.devonlinetestserver.com

# -----------------------------------------------------------------------------
# Reverse proxy
# -----------------------------------------------------------------------------
# Required when nginx (or a load balancer) sits in front of PHP, which is the
# normal deployment. Without it the app sees the proxy's address instead of the
# employee's, so every punch records the proxy IP — the per-punch IP capture
# becomes a column full of 127.0.0.1 — and TLS looks like plain http.
#
# '127.0.0.1' for nginx on the same host. Behind a load balancer or Cloudflare,
# list that network's ranges instead. '*' is only safe when nothing except the
# proxy can reach the app's port, since a directly reachable app would let a
# caller forge their own IP with an X-Forwarded-For header.
TRUSTED_PROXIES=127.0.0.1

# -----------------------------------------------------------------------------
# Queue & cache
# -----------------------------------------------------------------------------
# The database queue needs no extra service, which suits a single box. Email and
# push are queued, so NOTHING is delivered unless something is draining the
# queue.
#
# Where this is running. 'vps' means systemd runs the queue worker and cron
# fires the scheduler every minute — see deploy/emp-worker.service. 'managed'
# is shared webspace, where neither is possible and both are driven by cron
# instead — see deploy/emp-webspace.cron.
#
# 'managed' is set here because hrams.devonlinetestserver.com points at the
# webspace, not at a VPS. Leaving it on 'vps' would make emp:preflight fail the queue
# check on a perfectly healthy cron-driven queue, because a five-minute wait is
# normal there and alarming on a daemon; the tolerance becomes fifteen minutes
# with 'managed', which absorbs a missed run. Change it back only alongside an
# actual move to a server with systemd on it.
HOSTING_MODE=managed

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# CHANGE ME — 'log' writes emails to the log file and delivers nothing. Leave
# approvals and rejections are built and queued; with MAIL_MAILER=log the
# employee is simply never told. This is the single most commonly missed setting
# in this deploy.
#
# Use a transactional provider (Postmark, SES, Mailgun, Resend) rather than the
# host's sendmail — a fresh server's IP has no sending reputation and its mail
# goes to spam.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Must be an address on a domain whose SPF and DKIM records you control, or the
# mail will be rejected or filed as spam regardless of the provider.
MAIL_FROM_ADDRESS="hr@klutchcleaning.com"
# Deliberately NOT "${APP_NAME}", though the old reason no longer applies:
# APP_NAME used to be a long title that would have filled the From column of
# every inbox, and it is now just "KEMP". The reason that remains is the real
# one — the From column should say who is writing, and to somebody opening a
# leave decision on their phone that is their employer, not the name of the
# software it was sent by. Set this to "KEMP" only if the client would rather
# staff recognise the product than the company.
MAIL_FROM_NAME="Klutch Cleaning"

# -----------------------------------------------------------------------------
# Database backups (db:backup, nightly at 02:10 via the scheduler)
# -----------------------------------------------------------------------------
# On Linux these are usually on PATH, so the defaults are right and these lines
# only need setting if `which mysqldump` comes back empty. On managed webspace
# it is worth actually running that check before trusting them: where the
# binaries are absent the nightly backup fails every night, and the first you
# would hear of it is the day you need a restore.
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

# Dumps must land outside the web root — a backup served over HTTP is a copy of
# every employee record on the internet. Better still is a path on a separate
# volume, because a server that loses its filesystem loses the backups with it.
#
# This is an absolute path under the hosting account, NOT /var/backups: managed
# webspace has no write access outside the account's own home, so the VPS
# default would fail on the first run. Set it to a directory beside the
# checkout and above public/ — e.g. /homepages/nn/dnnnnnnnnn/htdocs/backups —
# and confirm with `curl -I https://hrams.devonlinetestserver.com/backups/` that it is
# not reachable over the web.
BACKUP_PATH=/var/backups/emp
BACKUP_KEEP=14
BACKUP_COMPRESS=true

# -----------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
# Leave FCM_ENABLED=false until the service-account key is on the server. Off,
# the app sends no push at all; half-configured, every notification fails into
# failed_jobs. See Push-Notifications_Setup.md.
FCM_ENABLED=false
FCM_PROJECT_ID=

# Absolute path. Do NOT write this as ${STORAGE_PATH}/... — that is not a real
# variable, it expands to nothing, and the resulting path silently misses the
# config default.
FCM_CREDENTIALS=/var/www/emp/storage/app/firebase/service-account.json
FCM_ANDROID_CHANNEL=hrms_default

# -----------------------------------------------------------------------------
# The mobile app gate (B6.6)
# -----------------------------------------------------------------------------
# MOBILE_MIN_VERSION is the oldest app build this server will talk to. Leave it
# EMPTY unless you mean it: a version typed in here wrongly stops every handset
# in the company at an update screen, and the people it stops are the ones who
# clock in with it. Raise it only after the replacement build is actually live
# in both stores, and never above what the stores are serving.
#
# Compared on major.minor.patch; a +build suffix is ignored.
MOBILE_MIN_VERSION=
MOBILE_LATEST_VERSION=

# Both are required once MOBILE_MIN_VERSION is set — an update screen with no
# link is a dead end, and preflight refuses the pair.
MOBILE_STORE_URL_ANDROID=
MOBILE_STORE_URL_IOS=

# Shows the app a "back shortly" screen while the API keeps answering. This is
# NOT `php artisan down`, which returns 503 to everything and is indistinguish-
# able from an outage — the app would fall back to its offline cache and let
# somebody queue punches into a server being migrated underneath them.
#
# Turn it off the moment the window closes. Preflight fails a deploy that still
# has it on, because the failure is silent from the server's side: every handset
# shows the screen and nobody can record attendance.
MOBILE_MAINTENANCE=false
MOBILE_MAINTENANCE_MESSAGE=

# How long crash reports (B6.5) are kept. `crashes:prune` runs nightly at 03:20.
# Safe to delete on a timer in a way the audit trails are not — a crash report
# is diagnosis, nothing is calculated from one, and nobody is accountable to
# one. 0 keeps everything, which on an unwatched server means for ever.
MOBILE_CRASH_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Demo sign-in panel — for a client evaluating the system, never for production
# -----------------------------------------------------------------------------
# Puts one-click buttons on the login page, one per role, so somebody can see
# each of the four areas without being handed four sets of credentials.
#
# It is OFF here and must stay off on anything a stranger can reach: the panel
# prints working passwords on a public page. `QuickLogin::enabled()` refuses to
# render it when APP_ENV=production whatever this says, and `emp:preflight`
# FAILS a deploy that leaves it on — both deliberately, because the cost of
# forgetting is full administrator access to every employee record, the document
# vault included, for anyone who finds the URL.
DEMO_QUICK_LOGIN=false

# Comma-separated `email:password` pairs. Nothing here is taken on trust: each
# account is looked up, its password checked against the stored hash and its
# role read from the database, so a button is only drawn if it would really
# sign in. The panel shows ONE account per role, ordered admin, HR, manager,
# employee — naming two employees and no manager just loses the manager area,
# which is usually the one a client most wants to see.
#
# Give each demo account a real password and CHANGE THE SEEDED ONES FIRST:
# preflight fails separately on any account still using "password".
#
#   DEMO_QUICK_LOGIN_ACCOUNTS="admin@example.com:...,hr@example.com:...,manager@example.com:...,employee@example.com:..."
DEMO_QUICK_LOGIN_ACCOUNTS=
