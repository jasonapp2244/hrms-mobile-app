# Employment Management Portal — the scheduler
#
# Install:
#   sudo cp deploy/emp-scheduler.cron /etc/cron.d/emp
#   sudo chmod 644 /etc/cron.d/emp
#
# One line, running every minute. Laravel decides internally what is actually
# due — routes/console.php holds the real schedule, so nothing here changes when
# a job is added or its timing moves.
#
# What stops if this line is missing:
#   attendance:remind-checkout   every 15 min  — nobody is reminded they are still clocked in
#   attendance:close-day         hourly        — open punches are never closed, hours stay wrong
#   reports:send                 hourly        — no scheduled report is ever emailed
#   attendance:report-late       10:30 daily   — HR is never told who was late
#   documents:check-expiry       06:45 daily   — a visa or permit lapses with nobody warned
#   leave:process                01:30 daily   — no monthly accrual, and no year-end carry-forward
#   db:backup --verify           02:10 daily   — there are no backups at all
#
# The failure is silent in every case. Nothing errors; the work simply never
# happens, and the first sign is a month of unclosed shifts — or, worse, an
# expired right-to-work document nobody was told about.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# MAILTO makes cron email its own failures — a PHP fatal before Laravel boots
# would otherwise leave no trace anywhere. Set it to a real inbox.
MAILTO=ops@example.com

* * * * * www-data cd /var/www/emp && /usr/bin/php artisan schedule:run >> /var/log/emp-scheduler.log 2>&1
